{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortener",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "account_id": "294df54d6c2a9847124acb8555a12312",
  "assets": {
    // "directory" should be omitted because the Cloudflare Vite plugin determines this automatically: ./dist/client
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/",
      "!/app/*",
      "!/assets/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortener-production",
      "database_id": "e171323b-3bb5-4f34-9b95-14cc19cad23f",
      "preview_database_id": "d1e4bf70-f0ae-4e29-bbb4-70fac049661d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "route": {
    "pattern": "s.levischoonover.dev",
    "custom_domain": true
  },
  "preview_urls": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "shortener-preview",
        "database_id": "d1e4bf70-f0ae-4e29-bbb4-70fac049661d"
      }
    ]
  },
  "placement": {  "mode": "smart" }
}